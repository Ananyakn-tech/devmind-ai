NODE_ENV=development
PORT=5000

# PostgreSQL (from docker-compose or Railway)
DATABASE_URL=postgresql://devmind:devmind_secret@localhost:5432/devmind

# Anthropic AI
ANTHROPIC_API_KEY=sk-ant-your-key-here

# JWT
JWT_SECRET=your-super-long-random-jwt-secret-change-this

# CORS
CLIENT_URL=http://localhost:3000

# AWS S3 / Cloudflare R2 (for file uploads)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_BUCKET_NAME=devmind-uploads
AWS_REGION=us-east-1

# Email (optional — for invitation emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=DevMind <noreply@devmind.ai>
